# Suscripción de la app (usar una de las dos)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MERCADOPAGO_ACCESS_TOKEN=

# Email y mensajería
MAILERLITE_API_KEY=
MANYCHAT_API_KEY=
